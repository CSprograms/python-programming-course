# Environment variables for UCAM11 web app (optional)
# Copy this file to .env and update values as needed
# Note: This is a static site, so most variables are not used

# Netlify deployment
# Set these in Netlify dashboard Settings → Build & deploy → Environment
# NETLIFY_AUTH_TOKEN=your_netlify_auth_token
# NETLIFY_SITE_ID=your_netlify_site_id

# Analytics (optional)
# GTAG_ID=your_google_analytics_id
# SENTRY_DSN=your_sentry_dsn

# Course metadata (optional)
# COURSE_TITLE="UCAM11I Python Programming"
# COURSE_DEPARTMENT="Computer Science"
# COURSE_INSTITUTION="Sri Sankara Arts and Science College"

# Build options
# PYTHON_VERSION=3.11
